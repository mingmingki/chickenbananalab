+		// The byte after the length is a DWG code page index (as in the file
+		// header), not a Windows code page number.  Reading it as a number
+		// decoded Korean XRECORD/extended-data strings as UTF-8 garbage.
+		// Unknown indexes keep the old behaviour.
+		private Encoding textEncodingFor(int index)
+		{
+			CodePage code = CadUtils.GetCodePage(index);
+			if (code != CodePage.Unknown)
+			{
+				if (this.Encoding != null && this.Encoding.CodePage == (int)code)
+					return this.Encoding;
+				try
+				{
+					return Encoding.GetEncoding((int)code);
+				}
+				catch (Exception) { }
+			}
+
+			return TextEncoding.GetListedEncoding((CodePage)index);
+		}
+
