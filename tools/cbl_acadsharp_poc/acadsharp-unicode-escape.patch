+	/// <summary>
+	/// Writes a character the drawing code page cannot hold as \U+XXXX, the
+	/// notation AutoCAD uses in pre-2007 DWG/DXF strings, instead of '?'.
+	/// </summary>
+	internal sealed class UnicodeEscapeEncoderFallback : EncoderFallback
+	{
+		public static Encoding Apply(Encoding encoding)
+		{
+			var clone = (Encoding)encoding.Clone();
+			clone.EncoderFallback = new UnicodeEscapeEncoderFallback();
+			return clone;
+		}
+
+		/// <summary>
+		/// The code page encoding as it was before <see cref="Apply"/>.  For
+		/// strings whose length is written as a character count (XRECORD and
+		/// extended data), where a 7-byte \U+XXXX would break the length.
+		/// </summary>
+		public static Encoding WithoutEscapes(Encoding encoding)
+		{
+			return encoding.EncoderFallback is UnicodeEscapeEncoderFallback ? Encoding.GetEncoding(encoding.CodePage) : encoding;
+		}
+
+		public override int MaxCharCount => 7;
+
+		public override EncoderFallbackBuffer CreateFallbackBuffer() => new Buffer();
+
+		private sealed class Buffer : EncoderFallbackBuffer
+		{
+			private string _text = string.Empty;
+			private int _index;
+
+			public override int Remaining => this._text.Length - this._index;
+
+			public override bool Fallback(char charUnknown, int index)
+			{
+				// A lone surrogate has no \U+ form, and U+FFFD marks a string the
+				// reader could not decode; both keep the old '?'.
+				this._text = char.IsSurrogate(charUnknown) || charUnknown == '\uFFFD' ? "?" : $"\\U+{(int)charUnknown:X4}";
+				this._index = 0;
+				return true;
+			}
+
+			public override bool Fallback(char charUnknownHigh, char charUnknownLow, int index)
+			{
+				// \U+ has four hex digits (BMP only), as in AutoCAD.
+				this._text = "?";
+				this._index = 0;
+				return true;
+			}
+
+			public override char GetNextChar() => this._index < this._text.Length ? this._text[this._index++] : '\0';
+
+			public override bool MovePrevious()
+			{
+				if (this._index == 0) return false;
+				this._index--;
+				return true;
+			}
+
+			public override void Reset()
+			{
+				this._text = string.Empty;
+				this._index = 0;
+			}
+		}
+	}
+}
