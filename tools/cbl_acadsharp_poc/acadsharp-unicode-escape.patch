+		/// <summary>
+		/// Pre-2007 strings hold characters outside the code page as \U+XXXX
+		/// (written so by AutoCAD and by our writer); turn them back into the
+		/// characters.  ASCII and surrogate values stay as written.
+		/// </summary>
+		internal static string DecodeUnicodeEscapes(string value)
+		{
+			if (value.IndexOf("\\U+", StringComparison.Ordinal) < 0) return value;
+			return System.Text.RegularExpressions.Regex.Replace(value, @"\\U\+([0-9A-Fa-f]{4})", m =>
+			{
+				int code = Convert.ToInt32(m.Groups[1].Value, 16);
+				return code < 0x80 || (code >= 0xD800 && code <= 0xDFFF) ? m.Value : ((char)code).ToString();
+			});
+		}
