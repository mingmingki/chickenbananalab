+		/// <summary>
+		/// Reads a pre-2007 XRECORD/extended-data string whose length is a
+		/// character count, as ACadSharp wrote them before our 2026-10-01 fix:
+		/// Korean takes two bytes per character, so the bytes ran past it.
+		/// </summary>
+		internal string ReadTextUnicodeByCharacters()
+		{
+			int charCount = this.ReadShort();
+			int encodingKey = this.ReadByte();
+			if (charCount <= 0)
+			{
+				return string.Empty;
+			}
+
+			Encoding encoding = this.textEncodingFor(encodingKey);
+			Decoder decoder = encoding.GetDecoder();
+			var bytes = new System.Collections.Generic.List<byte>();
+			byte[] one = new byte[1];
+			char[] chars = new char[4];
+			int read = 0;
+			while (read < charCount && bytes.Count < charCount * 4)
+			{
+				one[0] = this.ReadByte();
+				bytes.Add(one[0]);
+				read += decoder.GetChars(one, 0, 1, chars, 0, false);
+			}
+
+			return encoding.GetString(bytes.ToArray());
 		}
 
