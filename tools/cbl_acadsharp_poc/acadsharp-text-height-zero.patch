+	/// <summary>
+	/// Height as stored in a file.  AutoCAD keeps TEXT with height 0 ("use
+	/// the style height"); the <see cref="Height"/> setter rejects 0, which
+	/// made the DWG reader drop such entities and every save lose them.
+	/// </summary>
+	internal void SetStoredHeight(double value)
+	{
+		this._height = value;
 	}
 
