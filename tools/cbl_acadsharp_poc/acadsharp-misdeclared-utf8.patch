+		private static readonly Encoding strictUtf8 = new UTF8Encoding(false, true);
+
+		/// <summary>
+		/// An older ChickenBananaCAD pipeline saved pre-2007 strings as UTF-8 in
+		/// drawings whose code page is KS C 5601: decoded with the code page they
+		/// were garbage, and every save turned part of them into "?".  Bytes that
+		/// are valid UTF-8 and decode to Korean text (Hangul plus drawing symbols,
+		/// nothing else) are read as UTF-8; KS C 5601 text practically never is
+		/// valid UTF-8.  Mixed scripts are left alone: re-encoded old garbage can
+		/// form valid UTF-8 ("李⑷", "誘명몴湲"), and taking it would change text
+		/// between a save and its reread.  <see cref="DwgReader.MisdeclaredUtf8Strings"/>
+		/// counts them; with <see cref="DwgReader.PreferMisdeclaredUtf8"/> symbol-only
+		/// strings ("900×400") are taken too.  A save writes them in the code page.
+		/// </summary>
+		internal static string DecodeVariableText(byte[] bytes, Encoding encoding)
+		{
+			if (encoding.CodePage != Encoding.UTF8.CodePage && Array.Exists(bytes, b => b >= 0x80))
+			{
+				try
+				{
+					string utf8 = strictUtf8.GetString(bytes);
+					if (isKoreanText(utf8, DwgReader.PreferMisdeclaredUtf8))
+					{
+						System.Threading.Interlocked.Increment(ref DwgReader.misdeclaredUtf8Strings);
+						return utf8;
+					}
+				}
+				catch (DecoderFallbackException) { }
+			}
+
+			return encoding.GetString(bytes);
+		}
+
+		private const string drawingSymbols = "×°±·²³µ¼½¾ØøΦφ∅≤≥※→←↑↓∼";
+
+		private static bool isKoreanText(string text, bool symbolsOnly)
+		{
+			bool hangul = false;
+			foreach (char c in text)
+			{
+				if (c < 0x80)
+					continue;
+				if ((c >= '\uAC00' && c <= '\uD7A3') || (c >= '\u1100' && c <= '\u11FF') || (c >= '\u3130' && c <= '\u318F'))
+				{
+					hangul = true;
+					continue;
+				}
+				bool symbol = drawingSymbols.IndexOf(c) >= 0
+					|| (c >= '\u2460' && c <= '\u24FF')   // ① ⒜
+					|| (c >= '\u3000' && c <= '\u303F')   // CJK symbols and punctuation
+					|| (c >= '\u3380' && c <= '\u33FF')   // ㎡ ㎜
+					|| (c >= '\uFF01' && c <= '\uFF5E');  // fullwidth forms
+				if (!symbol)
+					return false;
+			}
+
+			return hangul || symbolsOnly;
+		}
+
