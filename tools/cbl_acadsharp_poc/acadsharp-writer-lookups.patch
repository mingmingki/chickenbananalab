+	private Dictionary<string, List<Insert>> _modelSpaceInserts;
+
+	// The model space INSERTs of a block, in model space order.  Built once per
+	// write: scanning every model space entity for each block record took
+	// seconds on drawings with many blocks (dimensions each have one).
+	private IEnumerable<Insert> modelSpaceInsertsOf(BlockRecord record)
+	{
+		if (record.Name == null)
+		{
+			return this._document.Entities.OfType<Insert>().Where(i => i.Block?.Name == null);
+		}
+
+		if (this._modelSpaceInserts == null)
+		{
+			this._modelSpaceInserts = new Dictionary<string, List<Insert>>(StringComparer.Ordinal);
+			foreach (Insert insert in this._document.Entities.OfType<Insert>())
+			{
+				string name = insert.Block?.Name;
+				if (name == null)
+				{
+					continue;
+				}
+
+				if (!this._modelSpaceInserts.TryGetValue(name, out List<Insert> list))
+				{
+					list = new List<Insert>();
+					this._modelSpaceInserts.Add(name, list);
+				}
+				list.Add(insert);
+			}
+		}
+
+		return this._modelSpaceInserts.TryGetValue(record.Name, out List<Insert> inserts) ? inserts : Enumerable.Empty<Insert>();
+	}
