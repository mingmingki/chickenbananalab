@@ -3,4 +3,5 @@ using ACadSharp.Objects;
 using CSMath;
 using System;
 using System.Collections.Generic;
+using System.IO;
 using System.Linq;
@@ -588,5 +589,8 @@ internal partial class DwgObjectWriter : DwgSectionIO
 				this.writeSolid(solid);
 				break;
 			case Solid3D solid3d:
-				this.writeSolid3D(solid3d);
+				this.writeModelerGeometry(solid3d);
+				break;
+			case Region region:
+				this.writeModelerGeometry(region);
 				break;
@@ -2174,6 +2178,40 @@ internal partial class DwgObjectWriter : DwgSectionIO
 		this._writer.WriteBitExtrusion(solid.Normal);
 	}
 
-	private void writeSolid3D(Solid3D solid)
+	private void writeModelerGeometry(ModelerGeometry geometry)
 	{
+		if (geometry.AcisData == null || geometry.AcisData.Length == 0)
+			throw new InvalidDataException($"Modeler geometry {geometry.ObjectName} has no ACIS payload");
+		if (this.R2010Plus)
+			throw new NotSupportedException($"Embedded ACIS writer only supports AC1018 and earlier R2000+ files: {this._version}");
+
+		this._writer.WriteBit(false);
+		this._writer.WriteBit(false);
+		short acisVersion = geometry.RawAcisVersion == 2 ? (short)2 : (short)1;
+		this._writer.WriteBitShort(acisVersion);
+		byte[] encoded = geometry.RawAcisData ?? AcisTextCodec.Decode(geometry.AcisData);
+		if (acisVersion == 2)
+		{
+			this._writer.WriteBytes(encoded);
+			return;
+		}
+		if (geometry.RawAcisBlocks.Count > 0)
+		{
+			foreach (byte[] block in geometry.RawAcisBlocks)
+			{
+				this._writer.WriteBitLong(block.Length);
+				this._writer.WriteBytes(block);
+			}
+		}
+		else
+		{
+			const int chunkSize = 0x4000;
+			for (int offset = 0; offset < encoded.Length; offset += chunkSize)
+			{
+				int count = Math.Min(chunkSize, encoded.Length - offset);
+				this._writer.WriteBitLong(count);
+				this._writer.WriteBytes(encoded, offset, count);
+			}
+		}
+		this._writer.WriteBitLong(0);
 	}
